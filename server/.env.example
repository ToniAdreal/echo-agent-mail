# Intenda backend environment (copy to server/.env for local dev; never commit .env)
APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/intenda.db
SESSION_SECRET=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=

# Agent model provider (OpenAI-compatible). Defaults target the Groq free tier.
# The key is read ONLY by the backend. LLM_* names win; GROQ_* are accepted as fallback.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b

# Optional real-mailbox OAuth (Demo Mailbox works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=

DEMO_MODE_ENABLED=true
DEMO_SYNC_DELAY_MS=700
AGENT_REQUESTS_PER_MINUTE=10
AGENT_REQUESTS_PER_DAY=100
LOG_LEVEL=INFO
