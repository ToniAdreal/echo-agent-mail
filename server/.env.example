# Intenda backend environment (copy to server/.env for local dev; never commit .env)
# Names match server/app/config.py exactly.
APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./intenda.db
SESSION_SECRET=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=
DEMO_MODE_ENABLED=true
DEMO_SYNC_DELAY_MS=450
LOG_LEVEL=INFO

# Agent model provider (OpenAI-compatible chat completions), called ONLY
# from the backend. Defaults target the Groq free tier. Leave the key empty
# to run the deterministic fallback (no model calls, no side effects).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
AGENT_REQUESTS_PER_MINUTE=10
AGENT_REQUESTS_PER_DAY=100
# GROQ_API_KEY=            (accepted as a fallback when LLM_API_KEY is unset)

# Optional real-mailbox OAuth (the Demo Mailbox works without these; an
# unconfigured provider returns PROVIDER_NOT_CONFIGURED at connect time)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=
